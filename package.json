{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-discord-rich-presence",
  "version": "0.1.0",
  "description": "Discord Rich Presence plugin for opencode — session stats, cross-platform IPC, privacy controls.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "discord",
    "rich-presence",
    "discord-rpc",
    "plugin",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vheins/opencode-discord-rich-presence.git"
  },
  "homepage": "https://github.com/vheins/opencode-discord-rich-presence#readme",
  "bugs": {
    "url": "https://github.com/vheins/opencode-discord-rich-presence/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.30"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@opencode-ai/plugin": "^1.18.30",
    "@opencode-ai/sdk": "^1.18.30",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
