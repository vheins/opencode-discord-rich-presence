# Discord Rich Presence — environment overrides.
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Precedence: global config file < project config file < environment < opencode.json options.

# Discord Application ID (required to enable presence).
# Create an application at https://discord.com/developers/applications and copy its ID.
DISCORD_APPLICATION_ID=000000000000000000

# Master toggle.
OPENCODE_DISCORD_ENABLED=true

# Verbose debug logging.
OPENCODE_DISCORD_DEBUG=false

# Application id aliases also accepted by the loader (highest priority first).
# OPENCODE_DISCORD_CLIENT_ID=
# DISCORD_APP_ID=

# Rich Presence assets.
DISCORD_LARGE_IMAGE_KEY=opencode
DISCORD_LARGE_IMAGE_TEXT=opencode
# DISCORD_SMALL_IMAGE_KEY=
# DISCORD_SMALL_IMAGE_TEXT=

# Privacy — hide sensitive session details from your Discord card.
OPENCODE_DISCORD_HIDE_PROJECT=false
OPENCODE_DISCORD_HIDE_MODEL=false
OPENCODE_DISCORD_HIDE_COST=false
OPENCODE_DISCORD_HIDE_FILES=true

# Idle timeout in milliseconds (clamped to 10s..1h).
OPENCODE_DISCORD_IDLE_TIMEOUT=300000

# Reconnect attempts before giving up (presence degrades gracefully).
OPENCODE_DISCORD_MAX_RETRIES=10
